####### Build rules

first: all
all: Makefile.Debug  ..\..\lib\QtGuid.prl $(DESTDIR_TARGET)

$(DESTDIR_TARGET): ui_qfiledialog.h ui_qpagesetupwidget.h $(OBJECTS) tmp\obj\debug_shared\QtGuid_resource.res
	$(LINK) $(LFLAGS) /OUT:$(DESTDIR_TARGET) @<< 
	  $(OBJECTS) $(LIBS)
<<
	-$(COPY_FILE) "$(DESTDIR_TARGET)" ..\..\bin

tmp\obj\debug_shared\QtGuid_resource.res: QtGuid_resource.rc
	rc -D_DEBUG $(DEFINES) -fo tmp\obj\debug_shared\QtGuid_resource.res QtGuid_resource.rc

..\..\lib\QtGuid.prl: 
	@$(QMAKE) -prl  ..\..\projects.pro
qmake:  FORCE
	@$(QMAKE) -o Makefile.Debug gui.pro

dist:
	$(ZIP) QtGuid.zip $(SOURCES) $(DIST) ..\..\projects.pro ..\..\mkspecs\features\exclusive_builds.prf ..\..\mkspecs\features\default_pre.prf ..\..\mkspecs\features\win32\default_pre.prf ..\..\.qmake.cache ..\..\mkspecs\qconfig.pri ..\..\mkspecs\modules\qt_webkit_version.pri ..\..\mkspecs\features\qt_functions.prf ..\..\mkspecs\features\qt_config.prf ..\..\include\QtGui\headers.pri ..\qt_install.pri ..\qt_targets.pri ..\qbase.pri kernel\win.pri animation\animation.pri kernel\kernel.pri ..\3rdparty\zlib_dependency.pri ..\3rdparty\libpng.pri image\qpnghandler.pri image\image.pri painting\painting.pri text\text.pri styles\styles.pri widgets\widgets.pri dialogs\dialogs.pri accessible\accessible.pri itemviews\itemviews.pri inputmethod\inputmethod.pri graphicsview\graphicsview.pri util\util.pri statemachine\statemachine.pri math3d\math3d.pri effects\effects.pri egl\egl.pri ..\..\mkspecs\features\debug.prf ..\..\mkspecs\features\debug_and_release.prf ..\..\mkspecs\features\default_post.prf ..\..\mkspecs\features\win32\default_post.prf ..\..\mkspecs\features\build_pass.prf ..\..\mkspecs\features\warn_on.prf ..\..\mkspecs\features\qt.prf ..\..\mkspecs\features\win32\thread.prf ..\..\mkspecs\features\moc.prf ..\..\mkspecs\features\win32\rtti.prf ..\..\mkspecs\features\win32\exceptions.prf ..\..\mkspecs\features\win32\stl.prf ..\..\mkspecs\features\shared.prf ..\..\mkspecs\features\dll.prf ..\..\mkspecs\features\win32\embed_manifest_exe.prf ..\..\mkspecs\features\win32\embed_manifest_dll.prf ..\..\mkspecs\features\win32\windows.prf ..\..\mkspecs\features\resources.prf ..\..\mkspecs\features\uic.prf ..\..\mkspecs\features\yacc.prf ..\..\mkspecs\features\lex.prf ..\..\mkspecs\features\include_source_dir.prf  HEADERS RESOURCES IMAGES SOURCES OBJECTIVE_SOURCES FORMS YACCSOURCES YACCSOURCES LEXSOURCES 

