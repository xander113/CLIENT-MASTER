####### Build rules

first: all
all: Makefile.QtWebKit.Release  ..\..\..\..\..\..\lib\QtWebKit.prl $(DESTDIR_TARGET)

$(DESTDIR_TARGET):  $(OBJECTS) ..\..\JavaScriptCore\release\jscore.lib ..\..\WebCore\release\webcore.lib tmp\obj\release_shared\QtWebKit_resource.res
	$(LINK) $(LFLAGS) /OUT:$(DESTDIR_TARGET) @<< 
	  $(OBJECTS) $(LIBS)
<<
	-$(COPY_FILE) "$(DESTDIR_TARGET)" ..\..\..\..\..\..\bin

tmp\obj\release_shared\QtWebKit_resource.res: QtWebKit_resource.rc
	rc $(DEFINES) -fo tmp\obj\release_shared\QtWebKit_resource.res QtWebKit_resource.rc

..\..\..\..\..\..\lib\QtWebKit.prl: 
	@$(QMAKE) -prl  ..\..\..\..\..\..\projects.pro
qmake:  FORCE
	@$(QMAKE) -o Makefile.QtWebKit.Release QtWebKit.pro

dist:
	$(ZIP) QtWebKit.zip $(SOURCES) $(DIST) ..\..\..\..\..\..\projects.pro ..\..\..\..\..\..\mkspecs\features\exclusive_builds.prf ..\..\..\..\..\..\mkspecs\features\default_pre.prf ..\..\..\..\..\..\mkspecs\features\win32\default_pre.prf ..\..\..\..\..\..\.qmake.cache ..\..\..\..\..\..\mkspecs\qconfig.pri ..\..\..\..\..\..\mkspecs\modules\qt_webkit_version.pri ..\..\..\..\..\..\mkspecs\features\qt_functions.prf ..\..\..\..\..\..\mkspecs\features\qt_config.prf Api\headers.pri ..\..\WebKit.pri ..\..\common.pri ..\..\JavaScriptCore\JavaScriptCore.pri ..\..\common.pri ..\..\WebCore\features.pri ..\..\WebCore\WebCore.pri ..\..\WebCore\CodeGenerators.pri ..\..\..\..\..\..\include\QtWebKit\headers.pri ..\..\..\..\..\qt_install.pri ..\..\..\..\..\qt_targets.pri ..\..\..\..\..\qbase.pri ..\..\..\..\..\..\mkspecs\features\release.prf ..\..\..\..\..\..\mkspecs\features\debug_and_release.prf ..\..\..\..\..\..\mkspecs\features\default_post.prf ..\..\..\..\..\..\mkspecs\features\win32\default_post.prf ..\..\..\..\..\..\mkspecs\features\build_pass.prf ..\..\..\..\..\..\mkspecs\features\warn_on.prf ..\..\..\..\..\..\mkspecs\features\qt.prf ..\..\..\..\..\..\mkspecs\features\win32\thread.prf ..\..\..\..\..\..\mkspecs\features\moc.prf ..\..\..\..\..\..\mkspecs\features\no_debug_info.prf ..\..\..\..\..\..\mkspecs\features\win32\rtti.prf ..\..\..\..\..\..\mkspecs\features\win32\exceptions.prf ..\..\..\..\..\..\mkspecs\features\win32\stl.prf ..\..\..\..\..\..\mkspecs\features\shared.prf ..\..\..\..\..\..\mkspecs\features\dll.prf ..\..\..\..\..\..\mkspecs\features\win32\embed_manifest_exe.prf ..\..\..\..\..\..\mkspecs\features\win32\embed_manifest_dll.prf ..\..\..\..\..\..\mkspecs\features\win32\windows.prf ..\..\..\..\..\..\mkspecs\features\resources.prf ..\..\..\..\..\..\mkspecs\features\uic.prf ..\..\..\..\..\..\mkspecs\features\yacc.prf ..\..\..\..\..\..\mkspecs\features\lex.prf ..\..\..\..\..\..\mkspecs\features\include_source_dir.prf ..\..\WebCore\release\webcore.prl ..\..\JavaScriptC