####### Build rules

first: all
all: Makefile.Release  release\webcore.prl $(DESTDIR_TARGET)

$(DESTDIR_TARGET):  $(OBJECTS) 
	$(LIBAPP) $(LIBFLAGS) /OUT:$(DESTDIR_TARGET) @<<
	  $(OBJECTS)
<<

release\webcore.prl: 
	@$(QMAKE) -prl  ..\..\..\..\..\projects.pro
qmake:  FORCE
	@$(QMAKE) -o Makefile.Release WebCore.pro

dist:
	$(ZIP) webcore.zip $(SOURCES) $(DIST) ..\..\..\..\..\projects.pro ..\..\..\..\..\mkspecs\features\exclusive_builds.prf ..\..\..\..\..\mkspecs\features\default_pre.prf ..\..\..\..\..\mkspecs\features\win32\default_pre.prf ..\..\..\..\..\.qmake.cache ..\..\..\..\..\mkspecs\qconfig.pri ..\..\..\..\..\mkspecs\modules\qt_webkit_version.pri ..\..\..\..\..\mkspecs\features\qt_functions.prf ..\..\..\..\..\mkspecs\features\qt_config.prf ..\WebKit.pri ..\common.pri features.pri WebCore.pri ..\common.pri ..\JavaScriptCore\JavaScriptCore.pri ..\..\..\..\..\mkspecs\features\release.prf ..\..\..\..\..\mkspecs\features\debug_and_release.prf ..\..\..\..\..\mkspecs\features\default_post.prf ..\..\..\..\..\mkspecs\features\win32\default_post.prf ..\..\..\..\..\mkspecs\features\build_pass.prf ..\..\..\..\..\mkspecs\features\staticlib.prf ..\..\..\..\..\mkspecs\features\static.prf ..\..\..\..\..\mkspecs\features\no_debug_info.prf ..\..\..\..\..\mkspecs\features\win32\rtti.prf ..\..\..\..\..\mkspecs\features\win32\exceptions.prf ..\..\..\..\..\mkspecs\features\win32\stl.prf ..\..\..\..\..\mkspecs\features\win32\embed_manifest_exe.prf ..\..\..\..\..\mkspecs\features\win32\embed_manifest_dll.prf ..\..\..\..\..\mkspecs\features\qt.prf ..\..\..\..\..\mkspecs\features\win32\thread.prf ..\..\..\..\..\mkspecs\features\moc.prf ..\..\..\..\..\mkspecs\features\win32\windows.prf ..\..\..\..\..\mkspecs\features\resources.prf ..\..\..\..\..\mkspecs\features\uic.prf ..\..\..\..\..\mkspecs\features\yacc.prf ..\..\..\..\..\mkspecs\features\lex.prf ..\..\..\..\..\mkspecs\features\include_source_dir.prf  HEADERS RESOURCES IMAGES SOURCES OBJECTIVE_SOURCES FORMS YACCSOURCES YACCSOURCES LEXSOURCES 

clean: compiler_clean 
